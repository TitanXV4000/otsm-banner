Windows Registry Editor Version 5.00

; Lets FileZilla open ftp:// links (the OTSM case banner's FTS button with "FTS opens in: Default FTP app").
; FileZilla doesn't register itself for ftp:// links. This does, for the current user only (no admin needed):
; - HKCU\Software\Classes\ftp: Windows uses it for ftp:// links when no default app has been chosen for FTP.
; - It also lists FileZilla under Settings > Apps > Default apps > "Choose defaults by link type" > FTP, if a
;   default was chosen there before and needs changing.
; Assumes FileZilla is in C:\Program Files\FileZilla FTP Client; change the paths below if yours is elsewhere.
; Test: Win+R, type ftp://anonymous@ftp.example.com/ and press Enter: FileZilla should start.
; To undo: delete HKEY_CURRENT_USER\Software\Classes\ftp, HKEY_CURRENT_USER\Software\Classes\FileZilla.ftp,
; HKEY_CURRENT_USER\Software\OTSM banner and the "FileZilla (ftp links)" value under
; HKEY_CURRENT_USER\Software\RegisteredApplications.

[HKEY_CURRENT_USER\Software\Classes\ftp]
@="URL:File Transfer Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\ftp\DefaultIcon]
@="\"C:\\Program Files\\FileZilla FTP Client\\filezilla.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\ftp\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\ftp\shell\open\command]
@="\"C:\\Program Files\\FileZilla FTP Client\\filezilla.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\FileZilla.ftp]
@="FTP link (FileZilla)"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\FileZilla.ftp\DefaultIcon]
@="\"C:\\Program Files\\FileZilla FTP Client\\filezilla.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\FileZilla.ftp\shell\open\command]
@="\"C:\\Program Files\\FileZilla FTP Client\\filezilla.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\OTSM banner\FileZilla\Capabilities]
"ApplicationName"="FileZilla"
"ApplicationDescription"="FileZilla FTP client"

[HKEY_CURRENT_USER\Software\OTSM banner\FileZilla\Capabilities\URLAssociations]
"ftp"="FileZilla.ftp"

[HKEY_CURRENT_USER\Software\RegisteredApplications]
"FileZilla (ftp links)"="Software\\OTSM banner\\FileZilla\\Capabilities"
