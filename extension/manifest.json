{
  "manifest_version": 3,
  "name": "OTSM case banner",
  "version": "1.7.6.1",
  "description": "Key facts of every OTSM (SMAX) case in one line at the top: status, contact, account and more, with related cases and entitlements.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://us42-smax.saas.microfocus.com/*"],
      "js": ["settings.js", "banner.js"],
      "css": ["banner.css"],
      "run_at": "document_idle"
    }
  ]
}
